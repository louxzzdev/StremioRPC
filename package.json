{
  "name": "stremio-rpc",
  "version": "1.0.0",
  "description": "Sends Stremio watching information to Discord Rich Presence.",
  "main": "index.js",
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "start": "electron .",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:linux:x64": "electron-builder --linux --x64 --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:win:x64": "electron-builder --win --x64 --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:mac:arm64": "electron-builder --mac --arm64 --publish never",
    "dist:mac:x64": "electron-builder --mac --x64 --publish never",
    "setup": "npm install",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "stremio-addon-sdk": "^1.6.10"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.bryan.stremio-rpc",
    "productName": "StremioRPC",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.js",
      "index.html",
      "renderer.js",
      "preload.js",
      "metadata.js",
      "Assets/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "Assets/DiscordRPCStremio.png"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "icon": "Assets/DiscordRPCStremio.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "Assets/DiscordRPCStremio.icns"
    }
  },
  "author": "Bryan Bueno <bryanrafaelbueno@gmail.com>",
  "license": "ISC",
  "allowScripts": {
    "electron@31.7.7": true,
    "github:devsnek/node-register-scheme#e7cc9a63a1f512565da44cb57316d9fb10750e17": true
  }
}
